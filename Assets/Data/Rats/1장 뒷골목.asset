  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 551d2ebdc9dbf10479df475a9525e215, type: 3}
  m_Name: "1장 뒷골목"
  m_EditorClassIdentifier: Assembly-CSharp::ChapterData
  chapterTitle: "1장. 뒷골목의 이빨"
  introLines:
  - speaker: "―"
    text: "물이 조금 빠진 뒷골목. 젖은 쓰레기 더미 사이로 무언가가 바스락거린다."
    portrait: {fileID: 0}
  - speaker: "틱"
    text: "조심해. 물이 빠진 골목에는 쥐들이 모여 살아."
    portrait: {fileID: 0}
  - speaker: "이안"
    text: "쥐 정도야 뭐."
    portrait: {fileID: 0}
  - speaker: "틱"
    text: "그냥 쥐가 아니야. 떠내려온 태엽판을 갉아 먹고 사는 녀석들이라고."
    portrait: {fileID: 0}
  - speaker: "???"
    text: "찍찍... 새 기억 냄새다. 반짝이는 태엽판 냄새."
    portrait: {fileID: 0}
  - speaker: "???"
    text: "녹도 안 슬었어. 기름 냄새도 나. 아까워라, 아까워."
    portrait: {fileID: 0}
  - speaker: "이안"
    text: "쥐가... 말을 해?"
    portrait: {fileID: 0}
  - speaker: "틱"
    text: "기억을 너무 많이 먹어서 그래. 먹어 치운 기억의 말투가 섞여 나오는 거야."
    portrait: {fileID: 0}
  - speaker: "???"
    text: "내놔. 그 판들, 전부 내놔. 물속은 춥고 배고파."
    portrait: {fileID: 0}
  - speaker: "틱"
    text: "물리면 상처가 녹처럼 번져. 오래 끌지 마!"
    portrait: {fileID: 0}
  - speaker: "이안"
    text: "알았어. 금방 끝낼게."
    portrait: {fileID: 0}
  battle: {fileID: 11400000, guid: 62628dac1741dc51c4032bfa62c68ec0, type: 2}
  outroLines:
  - speaker: "―"
    text: "쥐들이 달아난 자리에, 녀석들이 쥐고 있던 태엽판이 떨어져 있다."
    portrait: {fileID: 0}
  - speaker: "이안"
    text: "쥐들이 쓰던 태엽판이... 손 안으로 스며들어."
    portrait: {fileID: 0}
  - speaker: "틱"
    text: "그게 흡수야. 쓸 때마다 그 녀석들의 굶주림이 조금씩 새어 나올 거야."
    portrait: {fileID: 0}
  - speaker: "이안"
    text: "차갑다. 물에 젖은 것처럼."
    portrait: {fileID: 0}
  - speaker: "틱"
    text: "물에서 건진 기억은 다 그래. 기름을 먹이면 좀 나아지는데..."
    portrait: {fileID: 0}
  - speaker: "틱"
    text: "아, 그러고 보니 수로 건너편에 떠돌이 시계공이 산대. 아직 기름을 갖고 있다는 소문이 있어."
    portrait: {fileID: 0}
  - speaker: "이안"
    text: "기름이 있으면 네 무릎도 고칠 수 있겠네."
    portrait: {fileID: 0}
  - speaker: "틱"
    text: "...그런 건 잘도 기억하네. 고마워."
    portrait: {fileID: 0}
  - speaker: "틱"
    text: "그리고 이거. 골목 끝에서 주웠어. 멈춘 초침인데... 이상하게 따뜻해."
    portrait: {fileID: 0}
