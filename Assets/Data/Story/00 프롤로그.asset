  m_Script: {fileID: 11500000, guid: 551d2ebdc9dbf10479df475a9525e215, type: 3}
  m_Name: "00 프롤로그"
  m_EditorClassIdentifier: Assembly-CSharp::ChapterData
  chapterTitle: "프롤로그. 물에 잠긴 시계 마을"
  introLines:
  - speaker: "틱"
    text: "일어났어? 다행이다. 태엽이 다 풀린 줄 알았잖아."
    portrait: {fileID: 0}
  - speaker: "이안"
    text: "...여긴 어디지. 발밑이 전부 물이야."
    portrait: {fileID: 0}
  - speaker: "틱"
    text: "시계 마을이야. 종탑이 멈춘 날부터 물이 차오르기 시작했어."
    portrait: {fileID: 0}
  - speaker: "틱"
    text: "사람들의 기억은 태엽판이 되어 물 위를 떠다녀. 그걸 손에 쥐면 싸울 힘이 되지."
    portrait: {fileID: 0}
  - speaker: "이안"
    text: "남의 기억으로 싸운다고?"
    portrait: {fileID: 0}
  - speaker: "틱"
    text: "대가는 있어. 삼킨 기억이 많을수록 그 기억이 너를 조금씩 갉아먹을 거야."
    portrait: {fileID: 0}
  - speaker: "이안"
    text: "...종탑으로 가자. 왜 멈췄는지 알아야겠어."
    portrait: {fileID: 0}
  battle: {fileID: 0}
  outroLines:
  - speaker: "틱"
    text: "잠깐, 이거 받아. 내 태엽을 조금 나눠 줄게."
    portrait: {fileID: 0}
  - speaker: "틱"
    text: "버티는 동안 기력이 돌아올 거야. 무리하지 마."
    portrait: {fileID: 0}
  rewardCards:
  - {fileID: 11400000, guid: 41990bcb6445c2ab80031a436c5783cc, type: 2}
  - {fileID: 11400000, guid: 303db84955a890a2353cbde6e9fae8be, type: 2}
